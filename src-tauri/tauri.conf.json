{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi Claude",
  "mainBinaryName": "Multi Claude",
  "version": "0.6.3",
  "identifier": "app.multiclaude.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Multi Claude",
        "width": 1440,
        "height": 900,
        "minWidth": 920,
        "minHeight": 560,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#1a1a19"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/explorer/": "explorer/",
      "icons/icon.ico": "icon.ico",
      "icons/tray.png": "tray.png",
      "icons/tray@2x.png": "tray@2x.png"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/rudyatkinson/multi-claude-rust/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDREFDMTU2QUQ4MUVFQ0QKUldUTjdvR3RWc0hhZk9vbHJCQmxOOE5BR1pVMHFmcTRjd0hxT3pvZXRoMjNDaTVaTTk1dTU1NDkK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
